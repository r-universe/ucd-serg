[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "altdoc"]
	path = altdoc
	url = https://github.com/d-morrison/altdoc
	branch = recursive-qmd-search
	registered = false
[submodule "serocalculator"]
	path = serocalculator
	url = https://github.com/ucd-serg/serocalculator
[submodule "serodynamics"]
	path = serodynamics
	url = https://github.com/ucd-serg/serodynamics
[submodule "snapr"]
	path = snapr
	url = https://github.com/d-morrison/snapr
	registered = false
